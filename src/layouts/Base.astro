---
import "../styles/global.css";
import { freshLabel, jsonLd } from "../lib/format";
import { href } from "../lib/url";
import { meta } from "../lib/data";

interface Props {
  title: string;
  description: string;
  schema?: unknown;
}
const { title, description, schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://recompetes.com");
const fullTitle = title.includes("Recompetes") ? title : `${title} · Recompetes`;
const path = Astro.url.pathname;
const nav = [
  ["Radar", "recompetes/"],
  ["Contractors", "contractors/"],
  ["Agencies", "agencies/"],
  ["NAICS", "naics/"],
  ["Opportunities", "opportunities/"],
];
const fresh = freshLabel(meta.generated_at);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="Recompetes" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f3f0e8" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#101114" />
    <link rel="icon" href={href("favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Recompetes radar" href={href("feed.xml")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,520;9..144,650&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const theme = stored || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          document.documentElement.dataset.theme = theme;
        } catch (e) {}
      })();
    </script>
    {schema && <script type="application/ld+json" set:html={jsonLd(schema)} />}
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href={href()}>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <circle cx="14" cy="16" r="2.4" fill="currentColor"></circle>
            <path d="M14 7.5a9 9 0 0 1 7.6 4.2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
            <path d="M14 4a12.5 12.5 0 0 1 10.6 6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" opacity="0.55"></path>
            <circle cx="23" cy="11" r="1.8" fill="#e85d04"></circle>
          </svg>
          Recompetes
        </a>
        <nav class="site-nav" aria-label="Primary">
          {nav.map(([label, to]) => {
            const dest = href(to);
            const current = path === dest || (to !== "" && path.startsWith(dest));
            return <a href={dest} aria-current={current ? "page" : undefined}>{label}</a>;
          })}
        </nav>
        <div class="header-actions">
          <span class="fresh-pill">{fresh}</span>
          <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle color theme">
            <span class="when-light">Dark</span>
            <span class="when-dark">Light</span>
          </button>
          <a class="btn small" href={href("claim/")}>Feature your company</a>
        </div>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <a class="logo" href={href()}>Recompetes</a>
          <p class="lede" style="font-size:1rem;margin-top:0.6rem;">A free directory of federal prime contractors and the awards coming to the end of their term.</p>
        </div>
        <div>
          <h2>Directory</h2>
          <ul>
            <li><a href={href("recompetes/")}>Recompete Radar</a></li>
            <li><a href={href("contractors/")}>Contractors</a></li>
            <li><a href={href("agencies/")}>Agencies</a></li>
            <li><a href={href("naics/")}>NAICS</a></li>
            <li><a href={href("opportunities/")}>SAM notices</a></li>
            <li><a href={href("search/")}>Search</a></li>
          </ul>
        </div>
        <div>
          <h2>For companies</h2>
          <ul>
            <li><a href={href("claim/")}>Claim or feature a listing</a></li>
            <li><a href={href("advertise/")}>Advertise</a></li>
            <li><a href={href("alerts/")}>Recompete alerts</a></li>
            <li><a href={href("about/")}>Methodology</a></li>
            <li><a href={href("feed.xml")}>RSS feed</a></li>
          </ul>
        </div>
        <div>
          <h2>Sources</h2>
          <ul>
            <li><a href="https://www.usaspending.gov" target="_blank" rel="noopener noreferrer">USAspending.gov</a></li>
            <li><a href="https://sam.gov" target="_blank" rel="noopener noreferrer">SAM.gov</a></li>
            <li><a href={href("about/")}>How the daily update works</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap disclaimer">
        <p>{fresh}. Not an official U.S. government site. Award dollars are obligations reported to USAspending, not contract ceilings. A date on the radar means the current period of performance, or the last date to order, is ending. It is not a promise that the agency will compete the work again. Confirm every record on USAspending or SAM.gov before you spend capture time.</p>
      </div>
    </footer>
    <script>
      import { refreshDeadlines } from "../scripts/fresh";
      refreshDeadlines(document);
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch (e) {}
      });
      document.addEventListener("keydown", (event) => {
        const target = event.target as HTMLElement | null;
        const typing = target && (target.tagName === "INPUT" || target.tagName === "TEXTAREA" || target.isContentEditable);
        if (event.key === "/" && !typing) {
          const field = document.querySelector<HTMLInputElement>("#site-search, [data-filter-q]");
          if (field) {
            event.preventDefault();
            field.focus();
          }
        }
      });
    </script>
  </body>
</html>
