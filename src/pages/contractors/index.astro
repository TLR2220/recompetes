---
import Base from "../../layouts/Base.astro";
import { meta } from "../../lib/data";
import { href } from "../../lib/url";

const counts = meta.counts ?? { profiled: 0, searchable: 0, recompetes: 0, states: 0, notices: 0 };
const description = `${counts.profiled.toLocaleString("en-US")} federal contractor profiles, with ${(counts.searchable - counts.profiled).toLocaleString("en-US")} more names searchable. Obligations from ${meta.labels.obligations_window}.`;
---

<Base title="Federal contractor directory" description={description}>
  <div class="wrap page-head">
    <p class="crumbs"><a href={href()}>Home</a> / Contractors</p>
    <p class="eyebrow">Directory</p>
    <h1>{counts.profiled.toLocaleString("en-US")} profiles. {counts.searchable.toLocaleString("en-US")} names.</h1>
    <p class="lede">Profiles cover the largest primes and a deep cut of small and socioeconomic businesses, ranked by contract obligations from {meta.labels.obligations_window}. Everyone else in the index is searchable and opens on USAspending until a profile is added. The daily job keeps growing the list.</p>
  </div>
  <div class="wrap section" id="directory-app" data-base={import.meta.env.BASE_URL} data-version={meta.generated_at}>
    <div class="filters">
      <label class="field"><span>Search profiles</span><input data-filter-q placeholder="Name, UEI, agency" /></label>
      <label class="field"><span>State</span><select data-filter-state><option value="">All states</option></select></label>
      <label class="field"><span>Set-aside</span>
        <select data-filter-setaside>
          <option value="">Any</option>
          <option value="small">Small business</option>
          <option value="8a">8(a)</option>
          <option value="sdvosb">SDVOSB</option>
          <option value="wosb">WOSB</option>
          <option value="hubzone">HUBZone</option>
        </select>
      </label>
      <label class="field"><span>Sort</span>
        <select data-filter-sort>
          <option value="amount">Obligations</option>
          <option value="name">Name</option>
        </select>
      </label>
    </div>
    <p class="count-line" data-dir-status>Loading profiles…</p>
    <div class="cards three" data-dir-grid></div>
    <div class="pager" data-dir-pager></div>
    <p style="margin-top:0.6rem;"><a href={href("search/")}>Search the wider index, including firms without a profile yet</a></p>
  </div>
</Base>

<script>
  import { mountDirectory } from "../../scripts/directory";
  const root = document.getElementById("directory-app");
  if (root) mountDirectory(root);
</script>
