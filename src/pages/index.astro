---
import Base from "../layouts/Base.astro";
import Badge from "../components/Badge.astro";
import { agencies, contractors, meta, opportunities, profileOf, upcomingRecompetes } from "../lib/data";
import { daysLabel, freshLabel, money, openNotice, prettyDate, urgency } from "../lib/format";
import { absolute, href } from "../lib/url";
import { tiers } from "../config";

const upcoming = upcomingRecompetes();
const hero = [...upcoming].filter((row) => row.amount >= 25_000_000).slice(0, 3);
const heroRows = hero.length ? hero : upcoming.slice(0, 3);
const radar = upcoming.slice(0, 8);
const notices = opportunities.filter((row) => openNotice(row.type)).slice(0, 5);
const obligationTotal = contractors.reduce((sum, row) => sum + row.total_obligations, 0);
const radarDollars = upcoming.reduce((sum, row) => sum + row.amount, 0);
const description = "Free directory of federal prime contractors and the large awards coming to the end of their term. Incumbent, agency, obligated value, and end date — updated daily from USAspending and SAM.gov.";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "Recompetes",
      url: absolute(),
      description,
      potentialAction: {
        "@type": "SearchAction",
        target: `${absolute("search/")}?q={query}`,
        "query-input": "required name=query",
      },
    },
    {
      "@type": "ItemList",
      name: "Recompete Radar",
      itemListElement: radar.map((row, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: `${row.description} — ${row.incumbent}`,
        url: absolute(`contractors/${row.slug}/`),
      })),
    },
  ],
};
---

<Base title="Recompetes — federal contractor directory and recompete radar" description={description} schema={schema}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Federal contractor directory · Free</p>
        <h1>See the contracts before they come back to market.</h1>
        <p class="lede">Recompetes tracks incumbents, agencies, and end dates on the largest prime awards, then lines them up against the newest SAM.gov notices. No login. Rebuilt every day from public data.</p>
        <form class="search" action={href("search/")} method="get" role="search">
          <label class="sr-only" for="site-search">Search the directory</label>
          <input id="site-search" name="q" placeholder="Contractor, agency, NAICS, or keyword" autocomplete="off" />
          <button class="btn" type="submit">Search</button>
        </form>
        <p class="hint">Press <kbd>/</kbd> to search · {freshLabel(meta.generated_at)} · Obligations {meta.labels.obligations_window}</p>
      </div>
      <div class="hero-stack" aria-label="Soonest large awards">
        {heroRows.map((row) => (
          <a class="pulse-card" href={href(`contractors/${row.slug}/`)} data-end={row.end} data-urgency={urgency(row.days)}>
            <div class="days-xl num"><span data-days-label>{daysLabel(row.days)}</span></div>
            <div>
              <strong>{row.description}</strong>
              <small>{row.incumbent} · {row.agency}</small>
              <small class="num">{money(row.amount)} obligated · ends {prettyDate(row.end)}</small>
            </div>
          </a>
        ))}
      </div>
    </div>
    <div class="wrap stats">
      <div class="stat"><b class="num">{contractors.length}</b><span>Prime contractors profiled</span></div>
      <div class="stat"><b class="num">{money(obligationTotal)}</b><span>Obligated to them, {meta.labels.obligations_window}</span></div>
      <div class="stat"><b class="num">{upcoming.length}</b><span>Awards ending within {meta.labels.recompete_horizon}</span></div>
      <div class="stat"><b class="num">{money(radarDollars)}</b><span>Obligated on those ending awards</span></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Recompete Radar</p>
          <h2>Large awards coming to an end.</h2>
        </div>
        <a class="btn-quiet" href={href("recompetes/")}>Open the full radar</a>
      </div>
      <div data-filter-root>
        <div class="chips" role="group" aria-label="Horizon">
          <button type="button" data-horizon-btn="90">90 days</button>
          <button type="button" data-horizon-btn="180" aria-pressed="true">180 days</button>
          <button type="button" data-horizon-btn="365">12 months</button>
          <button type="button" data-horizon-btn="540">18 months</button>
        </div>
        <p class="count-line" data-filter-count style="margin:0.6rem 0;"></p>
        <div class="panel">
          <table class="radar">
            <thead>
              <tr>
                <th>Contract</th>
                <th>Incumbent</th>
                <th>Agency</th>
                <th>Obligated</th>
                <th>Current end</th>
                <th>Left</th>
              </tr>
            </thead>
            <tbody>
              {radar.map((row) => (
                <tr data-item data-end={row.end} data-days={row.days} data-amount={row.amount} data-text={`${row.description} ${row.incumbent} ${row.agency}`} data-urgency={urgency(row.days)}>
                  <td data-label="Contract"><div class="desc">{row.description}</div><div class="meta-line">{row.type}{row.award_id ? ` · ${row.award_id}` : ""}</div></td>
                  <td data-label="Incumbent"><a href={href(`contractors/${row.slug}/`)}>{row.incumbent}</a></td>
                  <td data-label="Agency">{row.agency_slug ? <a href={href(`agencies/${row.agency_slug}/`)}>{row.agency}</a> : row.agency}</td>
                  <td class="num" data-label="Obligated">{money(row.amount)}</td>
                  <td class="num" data-label="Current end">{prettyDate(row.end)}</td>
                  <td data-label="Left"><span class="days-pill"><span data-days-label>{daysLabel(row.days)}</span></span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="empty" data-filter-empty hidden>Nothing in this window on the homepage slice. Open the full radar for every tracked award.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <div class="section-head">
          <div>
            <p class="eyebrow">Live notices</p>
            <h2>Just posted on SAM.gov.</h2>
          </div>
          <a class="btn-quiet" href={href("opportunities/")}>All notices</a>
        </div>
        <div class="stack">
          {notices.map((notice) => (
            <a class="notice" href={notice.link} target="_blank" rel="noopener noreferrer">
              <header>
                <h3>{notice.title}</h3>
                <span class="tag">{notice.type}</span>
              </header>
              <p class="meta-line">{notice.agency}{notice.naics ? ` · NAICS ${notice.naics}` : ""} · Posted {prettyDate(notice.posted)}</p>
              <p class="meta-line">{notice.set_aside}{notice.deadline ? ` · Respond by ${prettyDate(notice.deadline)}` : ""}</p>
            </a>
          ))}
        </div>
      </div>
      <div>
        <div class="section-head">
          <div>
            <p class="eyebrow">Agencies</p>
            <h2>Where the money sits.</h2>
          </div>
        </div>
        <div class="stack">
          {agencies.slice(0, 6).map((agency) => (
            <a class="card" href={href(`agencies/${agency.slug}/`)}>
              <h3>{agency.name}</h3>
              <div class="amount num">{money(agency.amount)}</div>
              <p class="meta-line">Contract obligations, {meta.labels.obligations_window}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Contractors</p>
          <h2>The primes we profile.</h2>
        </div>
        <a class="btn-quiet" href={href("contractors/")}>Browse the directory</a>
      </div>
      <div class="cards three">
        {contractors.slice(0, 6).map((contractor) => {
          const placement = profileOf(contractor.slug);
          return (
            <a class="card" href={href(`contractors/${contractor.slug}/`)}>
              <Badge tier={placement?.tier} />
              <h3>{contractor.name}</h3>
              <div class="amount num">{money(contractor.total_obligations)}</div>
              <p class="meta-line">{[contractor.location.city, contractor.location.state].filter(Boolean).join(", ") || "Address on file varies"}</p>
              {contractor.next_recompete && <p class="meta-line">Next tracked end date {prettyDate(contractor.next_recompete.end)}</p>}
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">The directory stays free</p>
          <h2>Companies pay to be found. The data does not.</h2>
          <p>Every listing starts from the public record. Claim it, feature it, or sponsor a page when you want capture teams to see you first.</p>
        </div>
      </div>
      <div class="grid-3">
        {tiers.map((tier) => (
          <article class:list={["price", { featured: tier.featured }]}>
            <p class="eyebrow">{tier.kicker}</p>
            <h3>{tier.name}</h3>
            <p class="cost num">${tier.annual.toLocaleString("en-US")}<span> / year</span></p>
            <p class="meta-line">or ${tier.monthly}/month</p>
          </article>
        ))}
      </div>
      <p style="margin-top:1rem;"><a class="btn" href={href("claim/")}>See placements and pricing</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap panel" style="padding:1.2rem 1.3rem;">
      <div class="split" style="align-items:center;">
        <div>
          <p class="eyebrow">Alerts</p>
          <h2>A short list of awards about to end.</h2>
          <p class="lede" style="font-size:1.02rem;">Tell us the horizon and the floor. The digest is the radar, in your inbox, once delivery is connected.</p>
        </div>
        <form action={href("alerts/")} method="get" class="stack">
          <label class="sr-only" for="alert-email">Work email</label>
          <input id="alert-email" name="email" type="email" required placeholder="Work email" autocomplete="email" />
          <button class="btn" type="submit">Get recompete alerts</button>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  import { bindFilters } from "../scripts/filters";
  document.querySelectorAll<HTMLElement>("[data-filter-root]").forEach((root) => bindFilters(root));
</script>
