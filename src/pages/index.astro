---
import Base from "../layouts/Base.astro";
import highlightsFile from "../../data/highlights.json";
import { meta } from "../lib/data";
import { daysLabel, freshLabel, money, prettyDate, urgency } from "../lib/format";
import { absolute, href } from "../lib/url";
import { tiers } from "../config";
import type { RadarRow } from "../lib/types";

const highlights = highlightsFile as {
  hero: RadarRow[];
  radar: RadarRow[];
  contractors: { name: string; slug: string; amount: number; state?: string }[];
  notices: { title: string; agency: string; posted: string; link: string; type: string; naics?: string; set_aside?: string; deadline?: string }[];
  agencies: { slug: string; name: string; amount: number }[];
  states: { code: string; name: string; recompete_count: number; contractor_count: number }[];
  set_asides: { id: string; label: string; contractor_count: number; recompete_count: number }[];
};
const counts = meta.counts ?? { profiled: 0, searchable: 0, recompetes: 0, states: 0, notices: 0 };
const heroRows = highlights.hero.length ? highlights.hero : highlights.radar.slice(0, 3);
const description = "Free directory of federal prime contractors, small businesses, and the awards coming to the end of their term. Updated daily from USAspending and SAM.gov.";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "Recompetes",
      url: absolute(),
      description,
      potentialAction: {
        "@type": "SearchAction",
        target: `${absolute("search/")}?q={query}`,
        "query-input": "required name=query",
      },
    },
    {
      "@type": "ItemList",
      name: "Recompete Radar",
      itemListElement: highlights.radar.map((row, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: `${row.description} — ${row.incumbent}`,
        url: row.slug ? absolute(`contractors/${row.slug}/`) : absolute("recompetes/"),
      })),
    },
  ],
};
---

<Base title="Recompetes — federal contractor directory and recompete radar" description={description} schema={schema}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Federal contractor directory · Free</p>
        <h1>See the contracts before they come back to market.</h1>
        <p class="lede">Recompetes tracks incumbents, agencies, and end dates across thousands of primes and small businesses, then lines them up against the newest SAM.gov notices. No login. The index grows every day.</p>
        <form class="search" action={href("search/")} method="get" role="search">
          <label class="sr-only" for="site-search">Search the directory</label>
          <input id="site-search" name="q" placeholder="Contractor, agency, NAICS, state, or keyword" autocomplete="off" />
          <button class="btn" type="submit">Search</button>
        </form>
        <p class="hint">Press <kbd>/</kbd> to search · {freshLabel(meta.generated_at)} · Obligations {meta.labels.obligations_window}</p>
      </div>
      <div class="hero-stack" aria-label="Soonest large awards">
        {heroRows.map((row) => (
          <a class="pulse-card" href={row.slug ? href(`contractors/${row.slug}/`) : href("recompetes/")} data-end={row.end} data-urgency={urgency(row.days)}>
            <div class="days-xl num"><span data-days-label>{daysLabel(row.days)}</span></div>
            <div>
              <strong>{row.description}</strong>
              <small>{row.incumbent} · {row.agency}</small>
              <small class="num">{money(row.amount)} obligated · ends {prettyDate(row.end)}</small>
            </div>
          </a>
        ))}
      </div>
    </div>
    <div class="wrap stats">
      <div class="stat"><b class="num">{counts.profiled.toLocaleString("en-US")}</b><span>Contractor profiles</span></div>
      <div class="stat"><b class="num">{counts.searchable.toLocaleString("en-US")}</b><span>Names in the searchable index</span></div>
      <div class="stat"><b class="num">{counts.recompetes.toLocaleString("en-US")}</b><span>Awards ending within {meta.labels.recompete_horizon}</span></div>
      <div class="stat"><b class="num">{counts.notices.toLocaleString("en-US")}</b><span>Active SAM notices in the feed</span></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Recompete Radar</p>
          <h2>Awards coming to an end.</h2>
        </div>
        <a class="btn-quiet" href={href("recompetes/")}>Open the full radar</a>
      </div>
      <div class="panel">
        <table>
          <thead>
            <tr><th>Contract</th><th>Incumbent</th><th>Agency</th><th>Obligated</th><th>Current end</th><th>Left</th></tr>
          </thead>
          <tbody>
            {highlights.radar.map((row) => (
              <tr data-end={row.end} data-urgency={urgency(row.days)}>
                <td data-label="Contract"><div class="desc">{row.description}</div></td>
                <td data-label="Incumbent">{row.slug ? <a href={href(`contractors/${row.slug}/`)}>{row.incumbent}</a> : row.incumbent}</td>
                <td data-label="Agency">{row.agency}</td>
                <td class="num" data-label="Obligated">{money(row.amount)}</td>
                <td class="num" data-label="Current end">{prettyDate(row.end)}</td>
                <td data-label="Left"><span class="days-pill"><span data-days-label>{daysLabel(row.days)}</span></span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Set-asides</p>
          <h2>Small business, 8(a), SDVOSB, WOSB, HUBZone.</h2>
        </div>
        <a class="btn-quiet" href={href("set-asides/")}>All set-aside pages</a>
      </div>
      <div class="cards">
        {highlights.set_asides.map((item) => (
          <a class="card" href={href(`set-asides/${item.id}/`)}>
            <h3>{item.label}</h3>
            <p class="meta-line">{item.contractor_count.toLocaleString("en-US")} profiled firms · {item.recompete_count.toLocaleString("en-US")} tracked recompetes</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <div class="section-head">
          <div>
            <p class="eyebrow">Live notices</p>
            <h2>Just posted on SAM.gov.</h2>
          </div>
          <a class="btn-quiet" href={href("opportunities/")}>All notices</a>
        </div>
        <div class="stack">
          {highlights.notices.map((notice) => (
            <a class="notice" href={notice.link} target="_blank" rel="noopener noreferrer">
              <header>
                <h3>{notice.title}</h3>
                <span class="tag">{notice.type}</span>
              </header>
              <p class="meta-line">{notice.agency} · Posted {prettyDate(notice.posted)}</p>
            </a>
          ))}
        </div>
      </div>
      <div>
        <div class="section-head">
          <div>
            <p class="eyebrow">Where the work is</p>
            <h2>States with the most tracked ends.</h2>
          </div>
          <a class="btn-quiet" href={href("states/")}>All states</a>
        </div>
        <div class="stack">
          {highlights.states.map((state) => (
            <a class="card" href={href(`states/${state.code.toLowerCase()}/`)}>
              <h3>{state.name}</h3>
              <p class="meta-line">{state.recompete_count.toLocaleString("en-US")} recompetes · {state.contractor_count.toLocaleString("en-US")} contractors</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Directory</p>
          <h2>Profiles, not just a rank.</h2>
        </div>
        <a class="btn-quiet" href={href("contractors/")}>Browse contractors</a>
      </div>
      <div class="cards three">
        {highlights.contractors.map((contractor) => (
          <a class="card" href={href(`contractors/${contractor.slug}/`)}>
            <h3>{contractor.name}</h3>
            <div class="amount num">{money(contractor.amount)}</div>
            <p class="meta-line">{contractor.state || "Address on the USAspending record"}</p>
          </a>
        ))}
      </div>
      <p class="meta-line" style="margin-top:0.8rem;">The other {Math.max(0, counts.searchable - counts.profiled).toLocaleString("en-US")} recipients are in search, linked through to USAspending until a profile is built.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Agencies</p>
          <h2>Where the money sits.</h2>
        </div>
        <a class="btn-quiet" href={href("agencies/")}>All agencies</a>
      </div>
      <div class="cards three">
        {highlights.agencies.map((agency) => (
          <a class="card" href={href(`agencies/${agency.slug}/`)}>
            <h3>{agency.name}</h3>
            <div class="amount num">{money(agency.amount)}</div>
            <p class="meta-line">Contract obligations, {meta.labels.obligations_window}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">The directory stays free</p>
          <h2>Companies pay to be found. The data does not.</h2>
        </div>
      </div>
      <div class="grid-3">
        {tiers.map((tier) => (
          <article class:list={["price", { featured: tier.featured }]}>
            <p class="eyebrow">{tier.kicker}</p>
            <h3>{tier.name}</h3>
            <p class="cost num">${tier.annual.toLocaleString("en-US")}<span> / year</span></p>
            <p class="meta-line">or ${tier.monthly}/month</p>
          </article>
        ))}
      </div>
      <p style="margin-top:1rem;"><a class="btn" href={href("claim/")}>See placements and pricing</a></p>
    </div>
  </section>
</Base>
