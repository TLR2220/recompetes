---
import Base from "../../layouts/Base.astro";
import SponsorSlot from "../../components/SponsorSlot.astro";
import { contractors, naicsPages, recompetes, sponsors, tierRank } from "../../lib/data";
import { daysLabel, money, prettyDate, urgency } from "../../lib/format";
import { absolute, href } from "../../lib/url";
import type { NaicsPage } from "../../lib/types";

export function getStaticPaths() {
  return naicsPages.map((entry) => ({ params: { code: entry.code }, props: { entry } }));
}
interface Props { entry: NaicsPage; }
const { entry } = Astro.props;
const placement = sponsors.naics[entry.code] ?? null;
const radar = recompetes.filter((row) => row.days >= 0 && row.naics === entry.code);
const pinned = contractors.filter((contractor) => tierRank(contractor.slug) < 3 && contractor.naics.some((row) => row.code === entry.code));
const seen = new Set(pinned.map((row) => row.name.toUpperCase()));
const leaders = [
  ...pinned.map((row) => ({ name: row.name, slug: row.slug, amount: row.naics.find((item) => item.code === entry.code)?.amount || row.total_obligations, usaspending_url: row.usaspending_url })),
  ...entry.contractors.filter((row) => !seen.has(row.name.toUpperCase())),
];
const description = `NAICS ${entry.code} ${entry.name}: federal contract obligations, top contractors, and recompetes.`;
const schema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  name: `${entry.code} ${entry.name}`,
  description,
  url: absolute(`naics/${entry.code}/`),
  inDefinedTermSet: "NAICS",
};
---

<Base title={`NAICS ${entry.code} ${entry.name}`} description={description} schema={schema}>
  <div class="wrap page-head">
    <p class="crumbs"><a href={href()}>Home</a> / <a href={href("naics/")}>NAICS</a> / {entry.code}</p>
    <p class="eyebrow">{entry.sector_name}</p>
    <h1>{entry.code} {entry.name}</h1>
    <p class="lede">{money(entry.amount)} in contract obligations in the tracked window. Top recipients come from USAspending. Recompetes appear when an enriched award carries this exact code.</p>
  </div>
  <div class="wrap section"><SponsorSlot placement={placement} label="category" /></div>
  <section class="wrap section">
    <h2>Contractors in this code</h2>
    <div class="cards" style="margin-top:0.8rem;">
      {leaders.map((row) => (
        <article class="card">
          <h3>{row.slug ? <a href={href(`contractors/${row.slug}/`)}>{row.name}</a> : row.name}</h3>
          <div class="amount num">{money(row.amount)}</div>
          {!row.slug && row.usaspending_url && <p class="meta-line"><a href={row.usaspending_url} target="_blank" rel="noopener noreferrer">View on USAspending</a></p>}
        </article>
      ))}
    </div>
  </section>
  <section class="wrap section">
    <div class="section-head">
      <div>
        <h2>Recompetes in {entry.code}</h2>
        <p>{radar.length ? "Enriched from the largest awards on the radar." : "None of the enriched radar awards use this code yet. The contractor list above is still the spending rank."}</p>
      </div>
    </div>
    {radar.length > 0 && (
      <div class="panel">
        <table>
          <thead><tr><th>Contract</th><th>Incumbent</th><th>Agency</th><th>Obligated</th><th>End</th><th>Left</th></tr></thead>
          <tbody>
            {radar.map((row) => (
              <tr data-end={row.end} data-urgency={urgency(row.days)}>
                <td data-label="Contract"><div class="desc">{row.description}</div></td>
                <td data-label="Incumbent"><a href={href(`contractors/${row.slug}/`)}>{row.incumbent}</a></td>
                <td data-label="Agency">{row.agency}</td>
                <td class="num" data-label="Obligated">{money(row.amount)}</td>
                <td class="num" data-label="End">{prettyDate(row.end)}</td>
                <td data-label="Left"><span class="days-pill"><span data-days-label>{daysLabel(row.days)}</span></span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>
</Base>
