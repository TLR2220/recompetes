---
import Base from "../../layouts/Base.astro";
import SponsorSlot from "../../components/SponsorSlot.astro";
import highlightsFile from "../../../data/highlights.json";
import { meta, sponsors } from "../../lib/data";
import { moneyFull } from "../../lib/format";
import { absolute, href } from "../../lib/url";
import type { RadarRow } from "../../lib/types";

const preview = (highlightsFile as { radar: RadarRow[] }).radar;
const count = meta.counts?.recompetes ?? preview.length;
const description = `${count.toLocaleString("en-US")} federal awards of at least ${moneyFull(meta.labels.recompete_min)} with an end date inside ${meta.labels.recompete_horizon}. Filter by agency, state, set-aside, NAICS, and value.`;
const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Recompete Radar",
  description,
  url: absolute("recompetes/"),
  numberOfItems: count,
  itemListElement: preview.slice(0, 20).map((row, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: row.description,
    url: row.slug ? absolute(`contractors/${row.slug}/`) : absolute("recompetes/"),
  })),
};
---

<Base title="Recompete Radar" description={description} schema={schema}>
  <div class="wrap page-head">
    <p class="crumbs"><a href={href()}>Home</a> / Radar</p>
    <p class="eyebrow">Recompete Radar</p>
    <h1>{count.toLocaleString("en-US")} awards large enough to plan around.</h1>
    <p class="lede">Prime contracts and delivery orders from the contractors we profile, with at least {moneyFull(meta.labels.recompete_min)} obligated and a current end date inside {meta.labels.recompete_horizon}. Filter it here. The full list stays in one file so the site does not mint a page per award.</p>
  </div>
  <div class="wrap section" id="radar-app" data-base={import.meta.env.BASE_URL} data-version={meta.generated_at}>
    <SponsorSlot placement={sponsors.radar} label="radar" />
    <div class="filters" style="margin-top:0.9rem;">
      <label class="field"><span>Search</span><input data-filter-q placeholder="Incumbent, agency, keyword, PIID" /></label>
      <label class="field"><span>Agency</span><select data-filter-agency><option value="">All agencies</option></select></label>
      <label class="field"><span>State</span><select data-filter-state><option value="">All states</option></select></label>
      <label class="field"><span>Set-aside status</span>
        <select data-filter-setaside>
          <option value="">Any</option>
          <option value="small">Small business</option>
          <option value="8a">8(a)</option>
          <option value="sdvosb">SDVOSB</option>
          <option value="wosb">WOSB</option>
          <option value="hubzone">HUBZone</option>
        </select>
      </label>
    </div>
    <div class="toolbar">
      <label class="field"><span>NAICS starts with</span><input data-filter-naics inputmode="numeric" placeholder="5415" /></label>
      <label class="field"><span>Minimum</span>
        <select data-filter-min>
          <option value="1000000">$1 million</option>
          <option value="5000000">$5 million</option>
          <option value="25000000">$25 million</option>
          <option value="100000000">$100 million</option>
        </select>
      </label>
      <label class="field"><span>Horizon</span>
        <select data-filter-horizon>
          <option value="90">90 days</option>
          <option value="180">180 days</option>
          <option value="365">12 months</option>
          <option value="540" selected>18 months</option>
        </select>
      </label>
      <label class="field"><span>Sort</span>
        <select data-filter-sort>
          <option value="days">Ending soonest</option>
          <option value="amount">Largest obligated</option>
          <option value="agency">Agency</option>
          <option value="state">State</option>
        </select>
      </label>
      <label class="check"><input type="checkbox" data-filter-past /> Include awards that ended in the last {meta.labels.past_days} days</label>
    </div>
    <p class="count-line" data-radar-status>Loading the radar…</p>
    <div class="panel">
      <table>
        <thead><tr><th>Contract</th><th>Incumbent</th><th>Agency</th><th>Obligated</th><th>Current end</th><th>Left</th></tr></thead>
        <tbody data-radar-body></tbody>
      </table>
    </div>
    <div class="pager" data-radar-pager></div>
    <noscript><p class="empty">The full radar needs JavaScript. The homepage lists the soonest awards without it.</p></noscript>
    <p class="note" style="margin-top:1rem;">Set-aside status is the contractor’s reported business type. Place of performance is the award’s state when USAspending has one, otherwise the contractor’s address. Amounts are obligations, not ceilings.</p>
  </div>
</Base>

<script>
  import { mountRadar } from "../../scripts/radar";
  const root = document.getElementById("radar-app");
  if (root) mountRadar(root);
</script>
